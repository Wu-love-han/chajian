    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "INSTALL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "usage",
    "credits",
    "workbuddy",
    "foot-card"
  ],
  "author": "Wu-love-han",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wu-love-han/chajian.git"
  },
  "homepage": "https://github.com/Wu-love-han/chajian/tree/plugin/money-credits-card#readme",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  }
